# API-Football / api-sports.io tabanlı örnek
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# Buraya kendi API key gelecek
FOOTBALL_API_KEY=

# Virgülle lig ID gir.
# 203: Türkiye Süper Lig örneği
# 39: Premier League
# 140: La Liga
# 135: Serie A
# 78: Bundesliga
LEAGUE_IDS=203

# Sezon. API-Football'da 2026-2027 sezonu çoğunlukla 2026 olarak geçer.
SEASON=2026

# Saat dilimi
TIMEZONE=Europe/Istanbul

# Oran/ücret verisi çekmek istersen true yap.
# API planın odds desteklemiyorsa false kalsın.
FETCH_ODDS=false

# Kaç maça kadar odds denensin?
MAX_ODDS_FIXTURES=10

# API rate limit için bekleme süresi
REQUEST_DELAY_MS=1200
