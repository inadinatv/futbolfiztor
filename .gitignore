*.swp
*.swo

# Build artifacts
dist/
build/
target/
*.o
*.obj
*.so
*.dll
*.exe

# Coverage
coverage/
htmlcov/
.coverage

# Testing
.pytest_cache/
.mypy_cache/

# Compression
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
```