```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/

# Dependencies
.venv/
venv/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.so
.Python
*.egg-info/
.eggs/

# Distribution / packaging
.dist/
*.tar.gz
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Pytest
.pytest_cache/

# Mypy
.mypy_cache/

# JSON data files (if they are large/generated)
*.json

# Original rules preserved
*.log
```